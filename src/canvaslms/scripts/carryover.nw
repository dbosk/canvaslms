def write_canvas_files(directory):
  """Write what canvaslms prints about the made-up rounds into directory."""
  def write(name, rows):
    with open(directory / name, "w", newline="") as file:
      csv.writer(file, delimiter="\t").writerows(rows)
  write("users", ([ROOM, user, user] for user in LOGINS))
  write("assignments", ([ROOM, "LAB1", a, "", "", ""] for a in ASSIGNMENTS))
  write("submissions", ([ROOM, a, login(s), g, h, d]
                        for a, s, g, h, d in IN_ROOM))
  write("rounds", ([r, a, login(s), g, "2025-01-01 10:00", d]
                   for r, a, s, g, d in ROUNDS))
