def test_default_config_is_in_the_config_directory(run, tmp_path):
  config_dir = tmp_path / "xdg" / "canvaslms"
  config_dir.mkdir(parents=True)
  (config_dir / "ungraded.tsv").write_text("dd1301\tLAB\n")
  result, calls = run(None, args=[],
                      env={"XDG_CONFIG_HOME": str(tmp_path / "xdg")})
  assert result.returncode == 0, result.stderr
  assert [call[call.index("-c") + 1] for call in calls] == ["dd1301"]

