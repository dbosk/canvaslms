def test_course_built_from_course_id_when_not_attached():
  requester = MagicMock()
  requester.request.return_value.json.return_value = {
    "id": 98765, "quiz_type": "graded_survey"}
  survey = Assignment(requester, {
    "id": 4321, "course_id": 24725, "name": "Course evaluation",
    "quiz_id": 98765, "submission_types": ["online_quiz"]})

  assert is_survey(survey)
  assert requester.request.call_args.args[1] == "courses/24725/quizzes/98765"
