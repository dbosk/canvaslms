def test_nothing_done_yields_no_grade(self, grading_objects):
    user = grading_objects.user()

    grade, grade_date, _ = summarize(user, [
        self.exam(grading_objects, None), grading_objects.survey(None)])

    assert grade is None
    assert grade_date is None

def test_only_survey_done_yields_f(self, grading_objects):
    user = grading_objects.user()

    grade, grade_date, _ = summarize(user, [
        self.exam(grading_objects, None), self.survey(grading_objects)])

    assert grade == "F"
    assert grade_date.isoformat() == "2026-05-02"
