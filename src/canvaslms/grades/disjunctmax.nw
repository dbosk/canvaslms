def exam(self, grading_objects, grade="A"):
    if grade is None:
        return grading_objects.graded(None, name="Exam")
    return grading_objects.graded(grading_objects.submission(
        grade, submitted_at="2026-05-01T10:00:00Z"), name="Exam")

def survey(self, grading_objects, grade="100"):
    return grading_objects.survey(grading_objects.submission(
        grade, submitted_at="2026-05-02T10:00:00Z"))
