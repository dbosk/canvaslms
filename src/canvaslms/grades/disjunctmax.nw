def passed_exam(self, grading_objects):
    return grading_objects.graded(grading_objects.submission(
        "A", submitted_at="2026-05-01T10:00:00Z"), name="Exam")

def test_uncompleted_survey_reported_despite_passing_grade(
        self, grading_objects):
    user = grading_objects.user()
    survey = grading_objects.survey(None)

    rows = list(missing_assignments(
        [self.passed_exam(grading_objects), survey], [user]))

    assert rows == [(user, survey, "mandatory survey not completed")]

def test_completed_survey_never_reported(self, grading_objects):
    user = grading_objects.user()

    for survey_grade in ["50", None]:
        survey = grading_objects.survey(grading_objects.submission(
            survey_grade, submitted_at="2026-05-02T10:00:00Z"))

        rows = list(missing_assignments(
            [survey, self.passed_exam(grading_objects)], [user]))

        assert rows == []

def test_all_reported_when_no_passing_grade(self, grading_objects):
    user = grading_objects.user()
    failed = grading_objects.graded(grading_objects.submission(
        "F", submitted_at="2026-05-01T10:00:00Z"), name="Exam 1")
    unattempted = grading_objects.graded(None, name="Exam 2")
    survey = grading_objects.survey(None)

    rows = list(missing_assignments([failed, unattempted, survey], [user]))

    assert [row[1] for row in rows] == [survey, failed, unattempted]
