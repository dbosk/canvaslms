Let's verify that the aliases rank as their canonical grades, so that a
[[P+]] attempt outranks a failed one, and that a grade we can't rank says so
in terms the teacher can use.
<<test functions>>=
class TestRankingGrades:
    """Test the ranking of grades, aliases included."""

    def test_passing_aliases_rank_as_p(self):
        """P+ and complete are passed attempts, i.e. Ps."""
        for grade in ["P+", "complete", "Complete"]:
            assert grade_to_int(grade) == grade_to_int("P")

    def test_failing_aliases_rank_as_f(self):
        """The failing aliases rank below every passing grade."""
        for grade in [None, "incomplete", "must fix"]:
            assert grade_to_int(grade) == grade_to_int("F")

    def test_p_plus_outranks_a_failed_attempt(self):
        """Disjunctive maximum should pick the P+ attempt."""
        assert grade_max(["F", "P+"]) == "P"

    def test_unrankable_grade_names_grade_and_assignment(self):
        """An unusable grading scale should fail loudly, not silently."""
        with pytest.raises(ValueError) as error:
            grade_to_int("17.0", assignment="Lab 1")

        assert "17.0" in str(error.value)
        assert "Lab 1" in str(error.value)
