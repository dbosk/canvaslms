The passing aliases have to survive the same two paths: a [[P+]] attempt is a
passed attempt in the summary, and a student who has one is missing nothing at
all.
<<test functions>>=
class TestPassingGradeAliases:
    """Test the passing aliases P+ and complete."""

    def graded(self, grade):
        """Build an assignment whose submission carries the given grade."""
        assignment = SimpleNamespace(name="Exam")
        assignment.get_submission = Mock(
            return_value=SimpleNamespace(
                grade=grade,
                submitted_at="2026-01-10T10:00:00Z",
                graded_at=None,
                submission_history=[],
            )
        )
        return assignment

    def test_summarize_treats_p_plus_as_p(self):
        """A P+ attempt should summarize as a pass, not crash."""
        user = SimpleNamespace(id=1)

        grade, grade_date, graders = summarize(user, [self.graded("P+")])

        assert grade == "P"
        assert grade_date is not None

    def test_summarize_treats_complete_as_p(self):
        """Canvas pass/fail grading passes with 'complete'."""
        user = SimpleNamespace(id=1)

        grade, _, _ = summarize(user, [self.graded("complete")])

        assert grade == "P"

    def test_summarize_treats_incomplete_as_f(self):
        """Canvas pass/fail grading fails with 'incomplete'."""
        user = SimpleNamespace(id=1)

        grade, _, _ = summarize(user, [self.graded("incomplete")])

        assert grade == "F"

    def test_p_plus_leaves_nothing_missing(self):
        """One passing attempt is all disjunctive grading asks for."""
        user = SimpleNamespace(id=1)

        missing = list(
            missing_assignments([self.graded("P+")], [user])
        )

        assert missing == []
