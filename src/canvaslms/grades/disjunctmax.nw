def test_skipped_attempt_and_completed_survey_keep_the_max(
        self, grading_objects):
    """Neither the skipped exam nor the survey's grade affects the max."""
    user = grading_objects.user()

    for survey_grade in ["100", "50", None]:
        grade, grade_date, _ = summarize(user, [
            self.exam(grading_objects),
            self.exam(grading_objects, None),
            self.survey(grading_objects, survey_grade)])

        assert grade == "A"
        assert grade_date.isoformat() == "2026-05-02"
@

Conversely, an uncompleted survey vetoes the A.
<<mandatory survey test methods>>=
def test_uncompleted_survey_vetoes_grade(self, grading_objects):
    """A dateless or absent survey caps the grade at F."""
    user = grading_objects.user()
    dateless = grading_objects.survey(grading_objects.submission(None))
    absent = grading_objects.survey(None)

    for survey in [dateless, absent]:
        grade, grade_date, _ = summarize(
            user, [self.exam(grading_objects), survey])

        assert grade == "F"
        assert grade_date.isoformat() == "2026-05-01"
