Moving the vocabulary out of this module removed the branches that handled
\enquote{complete} and \enquote{incomplete} here, so we pin the behaviour those
branches used to provide.
The last test pins the one deliberate difference: a grade from a scale this
module cannot read now raises the module's own error instead of an
[[AttributeError]] from a [[casefold]] call.
<<test functions>>=
class TestCanvasPassFailGrades:
    """Test the grades from Canvas's built-in pass/fail grading type."""

    def graded(self, grade):
        """Build an assignment whose submission carries the given grade."""
        assignment = SimpleNamespace(name="Lab 1")
        assignment.get_submission = Mock(
            return_value=SimpleNamespace(
                grade=grade,
                submitted_at="2026-01-10T10:00:00Z",
                graded_at=None,
                submission_history=[],
            )
        )
        return assignment

    def test_complete_summarizes_as_p(self):
        """A complete is a pass, whatever its capitalization."""
        user = SimpleNamespace(id=1)

        for grade in ["complete", "Complete"]:
            summary, _, _ = summarize(user, [self.graded(grade)])
            assert summary == "P"

    def test_incomplete_summarizes_as_f(self):
        """An incomplete fails the group, as it always did."""
        user = SimpleNamespace(id=1)

        summary, _, _ = summarize(user, [self.graded("incomplete")])

        assert summary == "F"

    def test_complete_is_passing_and_incomplete_is_not(self):
        """The --missing check keeps the same verdicts."""
        assert is_passing_grade("complete")
        assert is_passing_grade("Complete")
        assert not is_passing_grade("incomplete")
        assert not is_passing_grade("must fix")
        assert not is_passing_grade(None)

    def test_unreadable_grade_names_grade_and_assignment(self):
        """A scale we can't read is an error the teacher can act on."""
        user = SimpleNamespace(id=1)

        with pytest.raises(ValueError) as error:
            summarize(user, [self.graded(17.0)])

        assert "17.0" in str(error.value)
        assert "Lab 1" in str(error.value)
