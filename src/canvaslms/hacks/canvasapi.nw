MISS_LIMIT_VARIABLES = ("CANVASLMS_MISS_REFRESH_MAX_LISTINGS",
                        "CANVASLMS_MISS_REFRESH_MAX_LISTINGS_ALL_COURSES")

def import_with_limits(**variables):
    """Import the module in a new process with `variables` in its environment.

    Returns the finished process, which printed the two limits.
    """
    environment = {name: value for name, value in os.environ.items()
                   if name not in MISS_LIMIT_VARIABLES}
    environment.update(variables)
    return subprocess.run(
        [sys.executable, "-c",
         "import canvaslms.hacks.canvasapi as module; "
         "module.report_setting_problems(); "
         "print(module.MISS_REFRESH_MAX_LISTINGS, "
         "module.MISS_REFRESH_MAX_LISTINGS_ALL_COURSES)"],
        env=environment, capture_output=True, text=True, check=True)

@pytest.mark.parametrize("variables,limits", [
    ({}, "25 5"),
    ({MISS_LIMIT_VARIABLES[0]: "40"}, "40 5"),
    ({MISS_LIMIT_VARIABLES[1]: "8"}, "25 8"),
    ({MISS_LIMIT_VARIABLES[0]: "0", MISS_LIMIT_VARIABLES[1]: "0"}, "0 0"),
])
def test_the_limits_come_from_the_environment(variables, limits):
    assert import_with_limits(**variables).stdout.strip() == limits

@pytest.mark.parametrize("variable", MISS_LIMIT_VARIABLES)
def test_a_malformed_limit_falls_back_to_the_default(variable):
    process = import_with_limits(**{variable: "many"})

    assert process.stdout.strip() == "25 5"
    assert f"{variable}='many'" in process.stderr
