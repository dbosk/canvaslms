The limit deserves tests of its own, since most of what can go wrong with it is
a refresh that does not happen, which looks just like a name that is not there.
We count what is fetched through the stand-in, and read what the user is told
from the log.
Only the listings that are old enough may count: three old ones among thirty
fit a limit of three.
<<test methods for the limit on a miss>>=
def owners(self, old=0, young=0):
    """Return owners of `old` listings to fetch and `young` ones not to."""
    return ([self.listing_owner() for _ in range(old)]
            + [self.listing_owner(age=timedelta(minutes=1))
               for _ in range(young)])

def search_all(self, owners, **kwargs):
    """Search the listings of all `owners` for what none of them has."""
    def find():
        return [obj for owner in owners for obj in owner.get_items()
                if obj.id == 3]

    return list(retry_after_miss(
        find, [(owner, "item") for owner in owners], **kwargs))

def fetched_again(self, owners):
    return sum(owner.listings - 1 for owner in owners)

def test_only_listings_old_enough_count(self, caplog):
    owners = self.owners(old=3, young=27)

    with caplog.at_level(logging.WARNING):
        self.search_all(owners, max_listings=3)

    assert [owner.listings for owner in owners] == [2] * 3 + [1] * 27
    assert "not fetching" not in caplog.text

def test_nothing_to_fetch_is_no_reason_to_warn(self, caplog):
    owners = self.owners(young=30)

    with caplog.at_level(logging.WARNING):
        self.search_all(owners, max_listings=1)

    assert self.fetched_again(owners) == 0
    assert not caplog.records

def test_nothing_to_fetch_is_no_reason_to_search_again(self):
    searches = []

    assert list(retry_after_miss(
        lambda: searches.append("search") or [],
        [(owner, "item") for owner in self.owners(young=1)])) == []

    assert len(searches) == 1

def test_over_the_limit_nothing_is_fetched(self):
    owners = self.owners(old=4)
    fetched = [owner.item_all_fetched for owner in owners]

    self.search_all(owners, max_listings=3)

    assert self.fetched_again(owners) == 0
    assert [owner.item_all_fetched for owner in owners] == fetched

def test_the_warning_says_how_many_and_how_to_get_past(self, caplog,
                                                       monkeypatch):
    """The default limit is looked up when searching, so this one applies."""
    monkeypatch.setattr(canvaslms.hacks.canvasapi,
                        "MISS_REFRESH_MAX_LISTINGS", 2)
