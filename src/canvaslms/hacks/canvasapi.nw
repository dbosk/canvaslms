        assert not must_update(merged, {"include": "user"})
        assert must_update(merged, {"include": "other"})

    def test_merges_includes_given_as_strings(self):
        """A single include may be given as a string"""
        result = merge_kwargs([{"include": "user"}, {"include": "email"}])

