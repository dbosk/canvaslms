This failure deserves a test of its own for the same reason the departed
student did: what we want is an \emph{absence}---no traceback---and an absence
is easy to lose again unnoticed.  We build an assignment whose cached
submissions are all stale enough to trigger the bulk refresh and whose Canvas
requests all fail.  Reading the collection must then hand back the cached
submissions with their cached values, say in the log which assignment went
unrefreshed, and---on a second listing, the way a command really calls
this---go back to Canvas no more.

The cache lives in attributes the decorator writes on the assignment.  They
look private, but the decorator is a plain function rather than a class body,
so Python performs no name mangling and the test can populate them by name.

<<test functions>>=
class TestBulkRefreshFailureKeepsCache:
    """A failing bulk refetch degrades to a warning, not a traceback."""

    class StandInSubmission:
        """A submission carrying a value we can recognise afterwards."""

        def __init__(self, user_id):
            self.grade = "cached"
            self.user_id = user_id

    def stale_assignment(self):
        """An assignment with a stale cache and a failing Canvas.

        Returns the assignment, the requester its bulk fetch goes through
        and the per-submission refetch its wrappers would fall back to.
        """
        requester = MagicMock()
        requester.request.side_effect = canvasapi.exceptions.CanvasException(
            "Internal Server Error")
        assignment = Assignment(requester, {"id": 17, "course_id": 1})

        refetch = MagicMock()
        cache = getattr(assignment, "__cache")
        for user_id in range(5):
            lazy = LazySubmission(
                self.StandInSubmission(user_id), assignment, set(), refetch)
            object.__setattr__(
                lazy, "_last_refresh",
                datetime.now() - timedelta(minutes=SUBMISSION_TTL_MINUTES + 1))
            cache[user_id] = lazy
        setattr(assignment, "__all_fetched", datetime.now())

        return assignment, requester, refetch

    def test_failed_bulk_refresh_serves_cached_submissions(self, caplog):
        """The listing still gets its submissions, with cached values."""
        assignment, _, _ = self.stale_assignment()

        with caplog.at_level(logging.WARNING):
            submissions = assignment.get_submissions(check_bulk_refresh=True)

        assert [each.grade for each in submissions] == ["cached"] * 5
        assert "Could not refresh all submissions" in caplog.text
        assert "id=17" in caplog.text

    def test_failed_bulk_refresh_is_not_retried(self):
        """The wrappers count as refreshed, so the reads stop retrying."""
        assignment, requester, refetch = self.stale_assignment()

        assignment.get_submissions(check_bulk_refresh=True)
        for each in assignment.get_submissions(check_bulk_refresh=True):
            each.grade

        requester.request.assert_called_once()
        refetch.assert_not_called()
