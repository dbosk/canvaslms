class TestPrecautionForEntriesThatLeft:
    """Canvas being down costs a warning, not the answer from the cache"""

    def make_instance(self):
        """Return an instance whose item 2 left, the listing old enough."""
        class TestClass:
            def __init__(self):
                self.requests = 0
                self.listed = [1, 2]
                self.fail = None
            def get_item(self, item_id, **kwargs):
                return canvas_object(id=item_id)
            def get_items(self, **kwargs):
                self.requests += 1
                if self.fail:
                    raise self.fail
                return [canvas_object(
                          id=each,
                          **{key: True for key in kwargs.get("include", [])})
                        for each in self.listed]

        CacheGetMethods("item")(TestClass)
        instance = TestClass()
        list(instance.get_items())
        instance.listed = [1]
        list(instance.get_items(include=["email"]))
        instance.item_all_fetched -= timedelta(
            minutes=MISS_REFRESH_MIN_AGE_MINUTES)
        instance.fail = requests.exceptions.ConnectionError("Unreachable")
        instance.requests = 0
        return instance

    @pytest.mark.parametrize("failure", [
        requests.exceptions.ConnectionError("Unreachable"),
        canvasapi.exceptions.CanvasException("Unavailable")])
    def test_the_cache_is_served_with_a_warning(self, caplog, failure):
        instance = self.make_instance()
        instance.fail = failure

        with caplog.at_level(logging.WARNING):
            items = list(instance.get_items(include=["email"]))

        assert sorted(item.id for item in items) == [1, 2]
        assert instance.requests == 1
        assert "Could not refresh" in caplog.text

    def test_a_failure_is_tried_and_told_once_per_run(self, caplog):
        instance = self.make_instance()

        with caplog.at_level(logging.WARNING):
            for _ in range(3):
                list(instance.get_items(include=["email"]))

        assert instance.requests == 1
        assert len(caplog.records) == 1

    def test_the_listing_keeps_its_date(self):
        instance = self.make_instance()
        fetched = instance.item_all_fetched

        list(instance.get_items(include=["email"]))

        assert instance.item_all_fetched == fetched

    def test_a_listing_that_answers_is_fetched_as_before(self):
        instance = self.make_instance()
        instance.fail = None
        instance.listed = [1, 2]

        items = list(instance.get_items(include=["email"]))

