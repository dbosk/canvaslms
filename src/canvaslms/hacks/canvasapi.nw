    def listing(self, url, ids, pages=None):
        """Let Canvas list `ids` at `url`; `pages` gives a page per request."""
        def answer(request):
            if pages:
                return pages.pop(0)
            return (200, {}, json.dumps([{"id": each, "name": str(each)}
                                         for each in ids]))
        responses.add_callback(responses.GET, url, callback=answer)

    def refetch(self, owner, attribute, how):
        """Make the next read of the listing fetch it, as a user would."""
        if how == "refresh":
            owner_fetched = getattr(owner, f"{attribute}_all_fetched")
            setattr(owner, f"{attribute}_all_fetched",
                    owner_fetched - timedelta(seconds=1))
            request_refresh()
        else:
            setattr(owner, f"{attribute}_all_fetched", None)

