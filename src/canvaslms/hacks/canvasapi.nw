        """A stale, non-final submission reports it would refresh."""
        lazy = self.wrap(grade="F", age_minutes=SUBMISSION_TTL_MINUTES + 1)
        assert lazy.would_need_refresh() is True

    def test_final_grade_never_needs_refresh(self):
