student_ids = kwargs.pop("student_ids", None)
<<pass a request for some submissions through to Canvas>>
<<let [[to_include]] be the includes asked for>>

need_refetch = (self.__all_fetched is None
                or predates_refresh(self.__all_fetched))

if not need_refetch:
  unlisted = getattr(self, "__unlisted", set())
  for user_id, lazy_submission in self.__cache.items():
    cached_includes = set(lazy_submission._includes)
    if (not to_include.issubset(cached_includes)
        and (user_id not in unlisted
             or old_enough_to_ask_again(self.__all_fetched))):
      need_refetch = True
      break

if need_refetch:
  for lazy_submission in self.__cache.values():
    to_include |= set(lazy_submission._includes)

  logger.info(f"Fetching all submissions for assignment id={self.id}")
  all_includes = to_include
  returned = set()
  for raw_submission in get_submissions(self, include=list(all_includes)):
    <<keep [[raw_submission]] in the cache>>
    returned.add(raw_submission.user_id)

  <<count all cached submissions as just refreshed>>
  self.__unlisted = set(self.__cache) - returned
  self.__all_fetched = datetime.now()
else:
  cache_age = datetime.now() - self.__all_fetched
  logger.info(f"Using cached submissions for assignment id={self.id}: "
              f"{len(self.__cache)} submissions cached "
              f"(age: {cache_age.total_seconds()/60:.1f} minutes)")

  if check_bulk_refresh and \
     should_bulk_refresh_submissions(self.__cache, student_ids):
    <<check staleness threshold and bulk refresh if needed>>

return list(self.__cache.values())
