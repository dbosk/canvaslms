Let's verify it on a real [[Course]] with a user, an assignment, a submission
and a module with one item, all fetched a given number of days ago.
The course itself was fetched now, as the daily listing leaves it.

<<test functions>>=
def days_ago(days):
    return datetime.now() - timedelta(days=days)

def course_with_contents_fetched(fetched):
    """Return a course whose contents were all fetched at `fetched`."""
    course = Course(None, {"id": 1, "name": "Old course"})
    course._fetched_at = datetime.now()

    user = User(None, {"id": 7, "name": "Anna"})
    assignment = Assignment(None, {"id": 5, "name": "Lab", "course_id": 1})
    submission = LazySubmission(
        Submission(None, {"id": 9, "user_id": 7, "grade": "P"}),
        assignment, set(), None)
    module = canvasapi.module.Module(None, {"id": 3, "name": "Week 1"})
    item = canvasapi.module.ModuleItem(None, {"id": 4, "title": "Read"})
    for obj in (user, assignment, module, item):
        obj._fetched_at = fetched
    object.__setattr__(submission, "_last_refresh", fetched)

    getattr(assignment, "__cache")[7] = submission
    module.module_item_cache[4] = (item, {})
    course.user_cache[7] = (user, {"include": ["enrollments"]})
    course.assignment_cache[5] = (assignment, {})
    course.module_cache[3] = (module, {})
    course.user_all_fetched = course.assignment_all_fetched = fetched
    course.user_all_kwargs = {"include": ["enrollments"]}
    return course

class TestForgettingUnusedContents:
    """Test that the file leaves out the contents of a course long unused"""

    def test_a_course_unused_for_long_keeps_only_itself(self):
        course = course_with_contents_fetched(days_ago(400))

        stored = pickled_for_file(course)

        assert stored.name == "Old course"
        assert (stored.user_cache, stored.assignment_cache,
                stored.module_cache) == ({}, {}, {})
        assert stored.user_all_fetched is None
        assert stored.assignment_all_fetched is None
        assert stored.user_all_kwargs == {"include": ["enrollments"]}
        assert len(course.user_cache) == 1
        assert course.user_all_fetched is not None

    @pytest.mark.parametrize("days,kept", [(89, True), (91, False)])
    def test_the_limit_is_the_number_of_days_to_keep(self, days, kept):
        stored = pickled_for_file(course_with_contents_fetched(days_ago(days)))

        assert bool(stored.user_cache) == kept
        assert bool(stored.assignment_cache) == kept

    @pytest.mark.parametrize("fresh", [
        lambda course: course.user_cache[7][0],
        lambda course: course.assignment_cache[5][0],
        lambda course: course.module_cache[3][0].module_item_cache[4][0],
    ], ids=["user", "assignment", "module item"])
    def test_one_recent_fetch_keeps_all_of_the_course(self, fresh):
        course = course_with_contents_fetched(days_ago(400))
        fresh(course)._fetched_at = datetime.now()

        stored = pickled_for_file(course)

        assert len(stored.user_cache) == 1
        assert len(stored.assignment_cache) == 1
        assert len(stored.module_cache) == 1
        assert stored.user_all_fetched is not None

    def test_a_recently_refreshed_submission_keeps_the_course(self):
        course = course_with_contents_fetched(days_ago(400))
        submission = getattr(course.assignment_cache[5][0], "__cache")[7]
        object.__setattr__(submission, "_last_refresh", datetime.now())

        stored = pickled_for_file(course)

        assert len(stored.user_cache) == 1
        assert len(getattr(stored.assignment_cache[5][0], "__cache")) == 1

    @pytest.mark.parametrize("keep_days", [0, -1])
    def test_no_limit_keeps_everything(self, monkeypatch, keep_days):
        monkeypatch.setattr(canvaslms.hacks.canvasapi, "CACHE_KEEP_DAYS",
                            keep_days)

        stored = pickled_for_file(course_with_contents_fetched(days_ago(4000)))

        assert len(stored.user_cache) == 1

    def test_losing_someone_who_had_left_is_a_warning(self, caplog):
        course = course_with_contents_fetched(days_ago(400))
        with caplog.at_level(logging.INFO):
            pickled_for_file(course)
        assert [record.levelno for record in caplog.records] == [logging.INFO]

        caplog.clear()
        course.user_cache[7][0]._unlisted = True
        with caplog.at_level(logging.INFO):
            pickled_for_file(course)

        warning, = caplog.records
        assert warning.levelno == logging.WARNING
        assert "1 user who had left" in warning.getMessage()
        assert "CANVASLMS_CACHE_KEEP_DAYS=0" in warning.getMessage()

    def test_an_attribute_that_only_looks_like_a_cache_is_left_alone(self):
        course = course_with_contents_fetched(days_ago(400))
        course.note_cache = "not a cache"

        stored = pickled_for_file(course)

        assert stored.note_cache == "not a cache"
        assert stored.user_cache == {}

    def test_contents_without_time_stamps_are_kept(self):
        course = Course(None, {"id": 1, "name": "New course"})
        created = Assignment(None, {"id": 5, "name": "Lab", "course_id": 1})
        course.assignment_cache[5] = (created, {})
        course.assignment_cache["note"] = "not an entry"

