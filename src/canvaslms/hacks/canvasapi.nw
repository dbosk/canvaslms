    def test_unions_list_values(self):
        """List values should be unioned"""
        kwargs1 = {"include": ["user"]}
        kwargs2 = {"include": ["enrollments"]}

        result = merge_kwargs([kwargs1, kwargs2])

        assert set(result["include"]) == {"user", "enrollments"}

