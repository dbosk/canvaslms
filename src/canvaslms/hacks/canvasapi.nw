def test_a_failure_stops_the_refresh(self, caplog):
    owners = self.owners(old=3)
    fetched = [owner.item_all_fetched for owner in owners]
    owners[1].fail = canvasapi.exceptions.CanvasException("Unavailable")

    with caplog.at_level(logging.WARNING):
