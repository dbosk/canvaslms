    def test_tuples_in_another_order_ask_for_nothing_new(self):
        canvas, sent = self.canvas()

        list(canvas.get_courses(include=("term", "teachers")))
        list(canvas.get_courses(include=("teachers", "term")))

        assert len(sent) == 1

