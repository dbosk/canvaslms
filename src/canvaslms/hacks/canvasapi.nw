class TestSubmissionsCanvasNoLongerLists:
    """A submission missing from the listing costs no fetch per read"""

    URL = "https://canvas.example.org"
    LISTING = f"{URL}/api/v1/courses/1/assignments/2/submissions"

    def assignment(self, listed):
        """Return an assignment and the requests its listing has received."""
        requests = []

        def answer(request):
            query = urllib.parse.urlsplit(request.url).query
            requests.append(set(urllib.parse.parse_qs(query).get("include[]", [])))
            return (200, {}, json.dumps(
                [{"id": each, "user_id": each, "assignment_id": 2, "grade": "F"}
                 for each in listed]))

        responses.add_callback(responses.GET, self.LISTING, callback=answer)
        canvas = canvasapi.Canvas(self.URL, "a token")
        return (Assignment(canvas._Canvas__requester,
                           {"id": 2, "course_id": 1}),
                requests)

    @responses.activate
    def test_it_costs_one_fetch_with_a_wider_include(self):
        listed = [1, 2]
        assignment, requests = self.assignment(listed)
        assignment.get_submissions(include=["rubric_assessment"])
        listed.remove(2)

        for _ in range(3):
            submissions = assignment.get_submissions(
                include=["submission_comments"])

        assert len(requests) == 2
        assert requests[-1] == {"rubric_assessment", "submission_comments"}
        assert len(submissions) == 2

    @responses.activate
    def test_one_submission_no_longer_listed_is_still_asked_for(self):
        """It really lacks what the listing got since, so it must not hide that."""
        listed = [1, 2]
        assignment, _ = self.assignment(listed)
        assignment.get_submissions(include=["rubric_assessment"])
        listed.remove(2)
        assignment.get_submissions(include=["submission_comments"])
        responses.get(f"{self.LISTING}/2",
                      json={"id": 2, "user_id": 2, "assignment_id": 2})
        calls = len(responses.calls)

        assignment.get_submission(2, include=["submission_comments"])

        assert len(responses.calls) == calls + 1

    @responses.activate
    def test_a_listed_submission_lacking_an_include_still_causes_a_fetch(self):
        """Fetched on its own, a new student's has less than the others have."""
        assignment, requests = self.assignment([1])
        assignment.get_submissions(include=["rubric_assessment"])
        responses.get(f"{self.LISTING}/3",
                      json={"id": 3, "user_id": 3, "assignment_id": 2})
        assignment.get_submission(3)

        assignment.get_submissions(include=["rubric_assessment"])

        assert len(requests) == 2

    @responses.activate
    def test_a_new_include_after_that_still_causes_a_fetch(self):
        listed = [1, 2]
        assignment, requests = self.assignment(listed)
        assignment.get_submissions(include=["rubric_assessment"])
        listed.remove(2)
        assignment.get_submissions(include=["submission_comments"])

        assignment.get_submissions(include=["submission_history"])

        assert len(requests) == 3
        assert requests[-1] == {"rubric_assessment", "submission_comments",
                                "submission_history"}

    @responses.activate
    def test_a_bulk_refresh_does_not_repeat_over_those_canvas_left_out(self):
        listed = list(range(5))
        assignment, requests = self.assignment(listed)
        assignment.get_submissions()
        del listed[1:]
        old = datetime.now() - timedelta(minutes=SUBMISSION_TTL_MINUTES + 1)
        for each in getattr(assignment, "__cache").values():
            object.__setattr__(each, "_last_refresh", old)

        for _ in range(3):
            assignment.get_submissions(check_bulk_refresh=True)

        assert len(requests) == 2

    @responses.activate
    def test_a_submission_that_returns_is_found_once_the_fetch_is_old_enough(self):
        listed = [1, 2]
        assignment, requests = self.assignment(listed)
        assignment.get_submissions(include=["rubric_assessment"])
        listed.remove(2)
        assignment.get_submissions(include=["submission_comments"])
        listed.append(2)
        setattr(assignment, "__all_fetched", datetime.now() - timedelta(
            minutes=MISS_REFRESH_MIN_AGE_MINUTES))

        for _ in range(2):
            submissions = assignment.get_submissions(
                include=["submission_comments"])

        assert len(requests) == 3
        cache = getattr(assignment, "__cache")
        assert "submission_comments" in cache[2]._includes
        assert len(submissions) == 2

    @responses.activate
    def test_an_assignment_from_an_earlier_version_can_be_read(self):
        """Pickles don't run constructors, so it has no record of who left."""
        assignment, requests = self.assignment([1])
        assignment.get_submissions(include=["rubric_assessment"])
        delattr(assignment, "__unlisted")

        assignment.get_submissions(include=["rubric_assessment"])

        assert len(requests) == 1

    @responses.activate
    def test_a_bulk_refresh_records_who_it_left_out(self):
        """Only the submission that left lacks what we then ask for."""
        listed = [1, 2]
        assignment, requests = self.assignment(listed)
        assignment.get_submissions(include=["rubric_assessment"])
        cache = getattr(assignment, "__cache")
        object.__setattr__(cache[1], "_includes",
                           {"rubric_assessment", "submission_comments"})
        for user_id in range(3, 3 + BULK_REFRESH_MIN_COUNT):
            cache[user_id] = LazySubmission(
                Submission(assignment._requester,
                           {"id": user_id, "user_id": user_id, "grade": "F"}),
                assignment, {"rubric_assessment", "submission_comments"},
                MagicMock())
            listed.append(user_id)
        listed.remove(2)
        old = datetime.now() - timedelta(minutes=SUBMISSION_TTL_MINUTES + 1)
        for each in cache.values():
            object.__setattr__(each, "_last_refresh", old)
        assignment.get_submissions(check_bulk_refresh=True)
        assert len(requests) == 2

        assignment.get_submissions(include=["submission_comments"])

        assert len(requests) == 2

    @responses.activate
    def test_a_new_include_after_a_bulk_refresh_still_causes_a_fetch(self):
        assignment, requests = self.assignment(list(range(5)))
        assignment.get_submissions()
        old = datetime.now() - timedelta(minutes=SUBMISSION_TTL_MINUTES + 1)
        for each in getattr(assignment, "__cache").values():
            object.__setattr__(each, "_last_refresh", old)
        assignment.get_submissions(check_bulk_refresh=True)
        assert len(requests) == 2

        assignment.get_submissions(include=["submission_comments"])

        assert len(requests) == 3
