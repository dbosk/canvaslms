    now = datetime.now()
    course = Course(None, {"id": 1, "name": "Course"})
    user = User(None, {"id": 7, "name": "A Student"})
    group = canvasapi.group.Group(None, {"id": 4, "name": "Anna and Bo"})
    assignment = Assignment(None, {"id": 2, "name": "Lab 1", "course_id": 1})
    submission = LazySubmission(
        Submission(None, {"id": 9, "user_id": 7, "grade": "P"}),
        assignment, set(), None)

    getattr(assignment, "__cache")[7] = submission
    setattr(assignment, "__all_fetched", now)
    setattr(assignment, "__unlisted", {8})
    group.user_cache[7] = (user, {})
    group.user_all_fetched = now
    course.user_cache[7] = (user, {"include": ["enrollments"]})
    course.user_all_fetched = now
    course.user_all_kwargs = {"include": ["enrollments"]}
    course.group_cache[4] = (group, {})
    course.group_all_fetched = now
    course.assignment_cache[2] = (assignment, {})
    course.assignment_all_fetched = now
    return course

def stored_with_exclusion(monkeypatch, kinds, obj=None):
    """Return what the file holds of `obj` when `kinds` are excluded."""
    monkeypatch.setattr(canvaslms.hacks.canvasapi, "CACHE_EXCLUDE", frozenset())
    assert exclude_from_cache_file(kinds) == []
    return pickled_for_file(obj or course_with_people())

class TestCacheExclusion:
