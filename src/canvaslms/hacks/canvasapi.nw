        assert (group.user_cache, group.user_all_fetched) == ({}, None)
        assert stored.user_cache is not group.user_cache
        assert stored.user_all_kwargs == {"include": ["enrollments"]}
        assert group.name == "Anna and Bo"
        assert stored.assignment_all_fetched is not None
        assert 7 in getattr(stored.assignment_cache[2][0], "__cache")

