class TestWhatAListingAsksFor:
    """A request of one object is no request of the listing"""

    URL = "https://canvas.example.org"
    LISTING = f"{URL}/api/v1/courses"

    def canvas(self):
        """Return a canvas and the include sets of the listing's requests."""
        listings = []

        def answer(request):
            query = urllib.parse.urlsplit(request.url).query
            listings.append(set(urllib.parse.parse_qs(query).get("include[]", [])))
            return (200, {}, json.dumps([{"id": 1, "name": "One"},
                                         {"id": 2, "name": "Two"}]))

        responses.add_callback(responses.GET, self.LISTING, callback=answer)
        responses.get(f"{self.LISTING}/1",
                      json={"id": 1, "name": "One, as fetched alone",
                            "syllabus_body": "<p>S</p>"})
        return canvasapi.Canvas(self.URL, "a token"), listings

    def expire(self, canvas):
        canvas.course_all_fetched -= timedelta(days=COURSE_CACHE_TTL_DAYS + 1)

    def singular_requests(self):
        return [call for call in responses.calls
                if urllib.parse.urlsplit(call.request.url).path.endswith("/1")]

    @responses.activate
    def test_the_next_listing_does_not_ask_for_the_syllabus(self):
        canvas, listings = self.canvas()
        list(canvas.get_courses())
        canvas.get_course(1, include=["syllabus_body"])
        self.expire(canvas)

        list(canvas.get_courses())

        assert len(listings) == 2
        assert "syllabus_body" not in listings[-1]

    @responses.activate
    def test_the_course_keeps_its_syllabus_after_the_listing(self):
        canvas, _ = self.canvas()
        list(canvas.get_courses())
        canvas.get_course(1, include=["syllabus_body"])
        self.expire(canvas)

        courses = {course.id: course for course in canvas.get_courses()}
        again = canvas.get_course(1, include=["syllabus_body"])

        assert courses[1].syllabus_body == "<p>S</p>"
        assert courses[1].name == "One"
        assert again.syllabus_body == "<p>S</p>"
        assert len(self.singular_requests()) == 1
        assert not hasattr(courses[2], "syllabus_body")

    def test_a_date_canvas_cleared_is_not_brought_back(self):
        """A stand-in, since only the listing's answer changes here."""
        class TestCanvas:
            end_at = "2026-01-01T00:00:00Z"
            def get_courses(self, **kwargs):
                return [canvas_object(Course, id=1, end_at=self.end_at)]
            def get_course(self, course_id, **kwargs):
                return canvas_object(Course, id=course_id, end_at=self.end_at,
                                     syllabus_body="<p>S</p>")

        CacheGetMethods("course")(TestCanvas)
        canvas = TestCanvas()
        list(canvas.get_courses())
        canvas.get_course(1, include=["syllabus_body"])
        canvas.end_at = None
        canvas.course_all_fetched = None

        [course] = canvas.get_courses()

        assert course.syllabus_body == "<p>S</p>"
        assert course.end_at is None
        assert not hasattr(course, "end_at_date")

    @responses.activate
    def test_a_listed_entry_loses_its_mark_with_the_syllabus_kept(self):
        canvas, _ = self.canvas()
        list(canvas.get_courses())
        canvas.get_course(1, include=["syllabus_body"])
        canvas.course_cache[1][0]._unlisted = True
        self.expire(canvas)

        courses = {course.id: course for course in canvas.get_courses()}

        assert courses[1].syllabus_body == "<p>S</p>"
        assert not getattr(courses[1], "_unlisted", False)

    @responses.activate
    def test_what_the_listing_was_asked_for_is_still_asked_for(self):
        canvas, listings = self.canvas()
        list(canvas.get_courses(include=["term"]))
