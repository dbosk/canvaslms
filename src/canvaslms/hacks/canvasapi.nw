class TestRequestsForASubset:
    """Test that a restriction never reaches the cached listing"""

    def make_instance(self):
        """Return an instance whose listing honours a restriction."""
        class TestClass:
            def __init__(self):
                self.requests = []
            def get_item(self, item_id, **kwargs):
                self.requests.append(kwargs)
                return canvas_object(id=item_id)
            def get_items(self, **kwargs):
                self.requests.append(kwargs)
                ids = [1] if "enrollment_type" in kwargs else [1, 2]
                return [canvas_object(id=each) for each in ids]

        CacheGetMethods("item")(TestClass)
        return TestClass()

    def with_restriction_stored(self, *ids):
        """Return an instance as an older version would have left it."""
        instance = self.make_instance()
        for item_id in ids:
            instance.item_cache[item_id] = (
                canvas_object(id=item_id),
                {"enrollment_type": ["student"], "include": ["a"]})
        instance.item_all_fetched = datetime.now()
        return instance

    @pytest.mark.parametrize("kwargs,restricts", [
        ({}, False),
        ({"include": ["a"]}, False),
        ({"sort": "name", "order": "asc", "order_by": "x"}, False),
        ({"per_page": 100}, False),
        ({"enrollment_type": ["student"]}, True),
        ({"include": ["a"], "search_term": "x"}, True)])
    def test_what_restricts_a_listing(self, kwargs, restricts):
        assert restricts_listing(kwargs) is restricts

    def test_a_subset_is_passed_through_and_not_cached(self):
        instance = self.make_instance()

        subset = list(instance.get_items(enrollment_type=["student"]))

        assert [obj.id for obj in subset] == [1]
        assert instance.item_cache == {}
        assert instance.item_all_fetched is None

    def test_a_page_size_is_cached_like_any_listing(self):
        instance = self.make_instance()

        list(instance.get_items(per_page=50))
        list(instance.get_items(per_page=100))

        assert len(instance.requests) == 1

    def test_a_restricted_singular_request_is_not_cached(self):
        instance = self.make_instance()
        list(instance.get_items())

        for _ in range(2):
            instance.get_item(1, all_dates=True)
        list(instance.get_items())

        assert instance.requests == [{}, {"all_dates": True}, {"all_dates": True}]
        assert instance.item_cache[1][1] == {}

    def test_a_restricted_singular_request_on_an_empty_cache(self):
        instance = self.make_instance()

        assert instance.get_item(1, all_dates=True).id == 1
        assert instance.item_cache == {}

    def test_a_subset_leaves_a_cached_listing_alone(self):
        instance = self.make_instance()
        list(instance.get_items())
        requests = len(instance.requests)

        list(instance.get_items(enrollment_type=["student"]))

        assert len(instance.requests) == requests + 1
        assert sorted(obj.id for obj in instance.get_items()) == [1, 2]
        assert len(instance.requests) == requests + 1

    def test_a_stored_restriction_is_fetched_properly_and_only_once(self):
        instance = self.with_restriction_stored(1)

        assert sorted(obj.id for obj in instance.get_items()) == [1, 2]
        assert sorted(obj.id for obj in instance.get_items()) == [1, 2]

        assert instance.requests == [{"include": ["a"]}]

    def test_an_entry_canvas_no_longer_lists_does_not_refetch_forever(self):
        instance = self.with_restriction_stored(1, 99)

        list(instance.get_items())
        list(instance.get_items())

        assert len(instance.requests) == 1
        assert instance.item_cache[99][1] == {"include": ["a"]}

    def test_a_stale_singular_does_not_inherit_a_restriction(self):
        instance = self.with_restriction_stored(1)
        obj, _ = instance.item_cache[1]
        obj._fetched_at = datetime.now() - timedelta(hours=1)
        canvaslms.hacks.canvasapi.request_refresh()
        try:
            instance.get_item(1)
        finally:
