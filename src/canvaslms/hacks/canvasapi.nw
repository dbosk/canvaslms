def canvas_says_it_is_gone(get_one, owner, key):
  """Return True if Canvas says that `key` is gone when `get_one` asks for it.

  That is a 404, the object does not exist, or a 403 saying that the user is not
  authorised, it exists but is closed to us; a 403 for throttling is not.
  `get_one` is a singular get method of `owner` that is not cached, or None, in
  which case nothing can be asked and the answer is False. The request gets one
  try, and any other failure, a 401 included, also gives False.
  """
  if get_one is None:
    return False
  try:
    with without_retries([owner]):
      get_one(owner, key)
  except canvasapi.exceptions.ResourceDoesNotExist:
    return True
  except canvasapi.exceptions.Forbidden as error:
    if (not isinstance(error, canvasapi.exceptions.RateLimitExceeded)
        and NOT_AUTHORISED.search(str(error))):
      return True
    logger.info(f"Kept in cache: {key} no longer listed, but Canvas refused "
                f"for another reason: {error}")
    return False
  except (canvasapi.exceptions.CanvasException,
          requests.exceptions.RequestException) as error:
    logger.info(f"Kept in cache: {key} no longer listed, but Canvas did not "
                f"say it is gone: {error}")
    return False
  logger.info(f"Kept in cache: {key} no longer listed, but Canvas has it")
  return False
