    assignment, sent = self.assignment()
    [cached] = assignment.get_submissions()

    [ungraded] = assignment.get_submissions(bucket="ungraded")

    assert len(sent) == 2
    assert sent[1]["bucket"] == ["ungraded"]
    assert ungraded is not cached
    assert assignment.get_submissions()[0] is cached
    assert len(sent) == 2

