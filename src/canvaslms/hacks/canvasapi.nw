class TestIncludesOfAListing:
    """Test that missing includes cause one fetch, with the largest set"""

    def make_instance(self):
        """Return an instance with a listing that sends what it is asked for."""
        class TestClass:
            def __init__(self):
                self.requests = []
                self.listed = [1, 2]
            def fetched(self, item_id, kwargs):
                self.requests.append(set(kwargs.get("include", [])))
                return canvas_object(
                    id=item_id, **{key: True for key in kwargs.get("include", [])})
            def get_item(self, item_id, **kwargs):
                return self.fetched(item_id, kwargs)
            def get_items(self, **kwargs):
                self.requests.append(set(kwargs.get("include", [])))
                return [canvas_object(
                          id=each,
                          **{key: True for key in kwargs.get("include", [])})
                        for each in self.listed]

        CacheGetMethods("item")(TestClass)
        return TestClass()

    def test_overlapping_includes_fetch_the_largest_set_once(self):
        instance = self.make_instance()
        list(instance.get_items(include=["enrollments", "avatar_url"]))

        items = list(instance.get_items(include=["email", "enrollments"]))

        assert all(item.email and item.avatar_url for item in items)
        assert instance.requests[-1] == {"enrollments", "avatar_url", "email"}
        assert len(instance.requests) == 2
        list(instance.get_items(include=["enrollments", "avatar_url"]))
        list(instance.get_items(include=["email"]))
        assert len(instance.requests) == 2

    def test_overlapping_includes_of_one_object_fetch_the_largest_set_once(self):
        instance = self.make_instance()
        instance.get_item(1, include=["enrollments", "avatar_url"])

        item = instance.get_item(1, include=["email", "enrollments"])

        assert item.email and item.avatar_url
        assert instance.requests[-1] == {"enrollments", "avatar_url", "email"}
        instance.get_item(1, include=["avatar_url"])
        assert len(instance.requests) == 2

    def test_an_entry_canvas_no_longer_lists_costs_one_fetch(self):
        instance = self.make_instance()
        list(instance.get_items(include=["enrollments"]))
        instance.listed = [1]

        for _ in range(3):
            items = list(instance.get_items(include=["email", "enrollments"]))

        assert len(instance.requests) == 2
        assert {item.id for item in items} == {1, 2}

    def test_what_was_asked_before_an_entry_left_still_counts(self):
        """The listing's record keeps `avatar_url`, which no listed entry has.

        Item 1's own record is set to `email` alone, so the union of the
        entries would hold `avatar_url` only through item 2, which left.
        """
        instance = self.make_instance()
        list(instance.get_items(include=["avatar_url"]))
        instance.listed = [1]
        list(instance.get_items(include=["email"]))
        instance.item_cache[1] = (instance.item_cache[1][0], {"include": ["email"]})

        list(instance.get_items(include=["enrollments"]))

        assert instance.requests[-1] == {"avatar_url", "email", "enrollments"}

    def test_one_object_canvas_no_longer_lists_is_still_asked_for(self):
        """It really lacks what the listing got since, so it must not hide that."""
        instance = self.make_instance()
        list(instance.get_items(include=["enrollments"]))
        instance.listed = [1]
        list(instance.get_items(include=["email", "enrollments"]))
        requests = len(instance.requests)

        item = instance.get_item(2, include=["email"])

        assert item.email
        assert len(instance.requests) == requests + 1

    def test_an_entry_that_returns_is_found_once_the_listing_is_old_enough(self):
        instance = self.make_instance()
        list(instance.get_items(include=["enrollments"]))
        instance.listed = [1]
        list(instance.get_items(include=["email", "enrollments"]))
        instance.listed = [1, 2]
        instance.item_all_fetched -= timedelta(
            minutes=MISS_REFRESH_MIN_AGE_MINUTES)
        requests = len(instance.requests)

        items = list(instance.get_items(include=["email", "enrollments"]))

        assert all(item.email for item in items)
        assert not getattr(instance.item_cache[2][0], "_unlisted", False)
        assert len(instance.requests) == requests + 1
