class TestSubmissionArguments:
    """The submission getters send Canvas what the caller asked for"""

    URL = "https://canvas.example.org"
    LISTING = f"{URL}/api/v1/courses/1/assignments/2/submissions"
    SUBMISSION = {"id": 3, "user_id": 3, "assignment_id": 2}

    def assignment(self):
        """Return an assignment and the query of each request it sends."""
        sent = []

        def answer(body):
            def callback(request):
                query = urllib.parse.urlsplit(request.url).query
                sent.append(urllib.parse.parse_qs(query))
                return (200, {}, json.dumps(body))
            return callback

        responses.add_callback(responses.GET, self.LISTING,
                               callback=answer([self.SUBMISSION]))
        responses.add_callback(responses.GET, f"{self.LISTING}/3",
                               callback=answer(self.SUBMISSION))
        canvas = canvasapi.Canvas(self.URL, "a token")
        return (Assignment(canvas._Canvas__requester,
                           {"id": 2, "course_id": 1}),
                sent)

    <<submission arguments test methods>>
@

A string is one include for both getters, and since the cache then records
what it really holds, asking again costs no request.
Likewise [[None]] is no include, sent or recorded.
