class TestBulkRefreshKeepsNames:
    """A bulk refresh keeps annotations and normalised names."""

    def test_bulk_refresh_keeps_annotations_and_names(self):
        payloads = [{"id": user_id, "user_id": user_id, "grade": "F"}
                    for user_id in range(BULK_REFRESH_MIN_COUNT)]
        response = MagicMock()
        response.json.return_value = [dict(each) for each in payloads]
        response.links = {}
        requester = MagicMock()
        requester.request.return_value = response
        requester.base_url = "https://canvas.example/api/v1/"
        requester.new_quizzes_url = "https://canvas.example/api/quiz/v1/"
        assignment = Assignment(requester, {"id": 17, "course_id": 1})

        user = object()
        cache = getattr(assignment, "__cache")
        for payload in payloads:
            lazy = LazySubmission(Submission(requester, dict(payload)),
                                  assignment, set(), MagicMock())
            lazy.ensure_attrs(["rubric_assessment"])
            lazy.user = user
            object.__setattr__(
                lazy, "_last_refresh",
                datetime.now() - timedelta(minutes=SUBMISSION_TTL_MINUTES + 1))
            cache[payload["user_id"]] = lazy
        old = object.__getattribute__(cache[0], "_submission")
        setattr(assignment, "__all_fetched", datetime.now())

        refreshed = assignment.get_submissions(check_bulk_refresh=True)[0]

        requester.request.assert_called_once()
        assert object.__getattribute__(refreshed, "_submission") is not old
        assert refreshed.user is user
        assert refreshed.rubric_assessment is None
