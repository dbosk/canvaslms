        assert 4 in stored.group_cache
        assert 7 in getattr(stored.assignment_cache[2][0], "__cache")

    def test_an_excluded_kind_is_reset_wherever_it_is_cached(self, monkeypatch):
        stored = stored_with_exclusion(monkeypatch, "user")

