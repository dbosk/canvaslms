@responses.activate
def test_the_listing_sends_a_string_include_whole(self):
    assignment, sent = self.assignment()

    for _ in range(2):
        submissions = assignment.get_submissions(include="user")

    assert [query["include[]"] for query in sent] == [["user"]]
    assert submissions[0]._includes == {"user"}

@responses.activate
def test_one_submission_sends_a_string_include_whole(self):
    assignment, sent = self.assignment()

    for _ in range(2):
        submission = assignment.get_submission(3, include="user")

    assert [query["include[]"] for query in sent] == [["user"]]
    assert submission._includes == {"user"}

@responses.activate
def test_include_none_asks_for_no_include(self):
    """Nothing is sent, and nothing is recorded as held."""
    assignment, sent = self.assignment()

    single = assignment.get_submission(3, include=None)
    [listed] = assignment.get_submissions(include=None)

    assert len(sent) == 2
    assert all("include[]" not in query for query in sent)
    assert single._includes == set()
    assert listed._includes == set()
