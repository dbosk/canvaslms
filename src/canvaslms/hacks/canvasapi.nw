change between two of them.
One test is for the harm described above: a listing that is still in use
although it and its entries are past the limit must be answered from the
cache, and once [[outdated]] has looked at the course, with one request.

<<test functions>>=
FILES_URL = "https://canvas.example/api/v1/courses/1/files"
FOLDERS_URL = "https://canvas.example/api/v1/courses/1/folders"
ROOT_FOLDER_JSON = {"id": 1, "name": "course files",
                    "full_name": "course files"}
SLIDES_JSON = {"id": 5, "name": "slides", "full_name": "course files/slides",
               "parent_folder_id": 1}

def file_json(file_id, name, folder_id=5):
    return {"id": file_id, "display_name": name, "filename": name,
            "folder_id": folder_id}

def course_with_files():
    """Return a real course whose Canvas has two files in a folder."""
    canvas = canvasapi.Canvas("https://canvas.example", "token")
    responses.get(FILES_URL, json=[file_json(7, "intro.pdf"),
                                   file_json(8, "lab.pdf")])
    responses.get(FOLDERS_URL, json=[ROOT_FOLDER_JSON, SLIDES_JSON])
    return Course(canvas._Canvas__requester, {"id": 1, "name": "Course"})

class TestFileAndFolderCaching:
    """Test that a course's files and folders are cached"""

    @responses.activate
    def test_the_listings_are_fetched_once_and_answer_single_lookups(self):
        course = course_with_files()

        for _ in range(2):
            assert [file.id for file in course.get_files()] == [7, 8]
            assert [folder.id for folder in course.get_folders()] == [1, 5]
        assert course.get_file(8).display_name == "lab.pdf"
        assert course.get_folder(5).full_name == "course files/slides"

        assert len(responses.calls) == 2

    @responses.activate
    def test_a_file_canvas_no_longer_lists_is_forgotten(self):
        course = course_with_files()
        list(course.get_files())
        responses.replace(responses.GET, FILES_URL,
                          json=[file_json(9, "intro.pdf")])
        course.file_all_fetched = None

        assert [file.id for file in course.get_files()] == [9]
        assert set(course.file_cache) == {9}

    @responses.activate
    @pytest.mark.parametrize("age_days,requests", [
        (DEFAULT_CACHE_TTL_DAYS - 1, 1), (DEFAULT_CACHE_TTL_DAYS + 1, 2)])
    def test_a_file_fetched_alone_is_fetched_again_when_old(
            self, age_days, requests):
        course = course_with_files()
        responses.get(f"{FILES_URL}/7", json=file_json(7, "intro.pdf"))
        file = course.get_file(7)
        responses.replace(responses.GET, f"{FILES_URL}/7",
                          json=file_json(7, "renamed.pdf", folder_id=1))
        file._fetched_at -= timedelta(days=age_days)

        again = course.get_file(7)

        assert len(responses.calls) == requests
        assert again.display_name == ("renamed.pdf" if requests == 2
                                      else "intro.pdf")

    @responses.activate
    def test_a_folder_fetched_alone_is_fetched_again_when_old(self):
        course = course_with_files()
        responses.get(f"{FOLDERS_URL}/5", json=SLIDES_JSON)
        folder = course.get_folder(5)
        folder._fetched_at -= timedelta(days=DEFAULT_CACHE_TTL_DAYS + 1)

        course.get_folder(5)

        assert len(responses.calls) == 2

    @responses.activate
    def test_an_old_listing_is_never_refreshed_one_file_at_a_time(self):
        course = course_with_files()
        list(course.get_files())
        for file, _ in course.file_cache.values():
            file._fetched_at -= timedelta(days=DEFAULT_CACHE_TTL_DAYS + 1)
        course.file_all_fetched -= timedelta(days=DEFAULT_CACHE_TTL_DAYS + 1)
        responses.calls.reset()

        assert [file.id for file in course.get_files()] == [7, 8]

        assert len(responses.calls) == 0
        outdated(course)
        assert [file.id for file in course.get_files()] == [7, 8]
        assert [call.request.path_url.split("?")[0]
                for call in responses.calls] == ["/api/v1/courses/1/files"]

    @responses.activate
    def test_a_folder_canvas_no_longer_lists_is_forgotten(self):
        course = course_with_files()
        list(course.get_folders())
        responses.replace(responses.GET, FOLDERS_URL, json=[ROOT_FOLDER_JSON])
        course.folder_all_fetched = None

        assert [folder.id for folder in course.get_folders()] == [1]
        assert set(course.folder_cache) == {1}

    @responses.activate
    def test_a_course_stored_before_files_were_cached_lists_them(self):
        course = course_with_files()
        del course.file_cache, course.file_all_fetched
        restored = pickle.loads(pickle.dumps(course))

        assert [file.id for file in restored.get_files()] == [7, 8]
