class TestAssignmentSubmissionRefreshStrategy:
    """Test the lazy submission bulk-refresh decision helper."""

    def make_lazy_submission(self, *, needs_refresh):
        """Create a cached lazy submission with configurable staleness."""
        lazy_submission = LazySubmission(
            canvas_object(Submission, id=1, user_id=1, grade="F"),
            listed_assignment(), set(), MagicMock())
        if needs_refresh:
            object.__setattr__(
                lazy_submission, "_last_refresh",
                datetime.now() - timedelta(minutes=SUBMISSION_TTL_MINUTES + 1))
        return lazy_submission

    def test_no_bulk_refresh_when_threshold_not_reached(self):
        """Fewer stale submissions than the threshold should skip bulk refresh."""
        cache = {
            user_id: self.make_lazy_submission(needs_refresh=user_id < 2)
            for user_id in range(10)
        }

        assert should_bulk_refresh_submissions(cache) is False

    def test_bulk_refresh_when_threshold_reached(self):
        """Meeting the threshold should trigger bulk refresh."""
        cache = {
            user_id: self.make_lazy_submission(needs_refresh=user_id < 3)
            for user_id in range(10)
        }

        assert should_bulk_refresh_submissions(cache) is True

    def test_bulk_refresh_threshold_scales_with_cache_size(self):
        """Larger caches should use the fractional threshold."""
        assert bulk_refresh_threshold(50) == 10
