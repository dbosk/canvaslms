class TestIncludesInAnyCollection:
    """Tuples, sets and generators are read as their items"""

    URL = "https://canvas.example.org"
    LISTING = f"{URL}/api/v1/courses"

    def canvas(self):
        """Return a canvas and the include sets of all its requests."""
        sent = []

        def answer(request):
            query = urllib.parse.urlsplit(request.url).query
            sent.append(set(urllib.parse.parse_qs(query).get("include[]", [])))
            if urllib.parse.urlsplit(request.url).path.endswith("/1"):
                return (200, {}, json.dumps({"id": 1, "name": "One"}))
            return (200, {}, json.dumps([{"id": 1, "name": "One"}]))

        responses.add_callback(responses.GET, self.LISTING, callback=answer)
        responses.add_callback(responses.GET, f"{self.LISTING}/1",
                               callback=answer)
        return canvasapi.Canvas(self.URL, "a token"), sent

    @responses.activate
    @pytest.mark.parametrize("include", [
        ("term", "teachers"),
        {"term", "teachers"},
        (each for each in ["term", "teachers"])],
        ids=["tuple", "set", "generator"])
    def test_a_listing_asked_for_any_collection(self, include):
        canvas, sent = self.canvas()

        list(canvas.get_courses(include=include))
        list(canvas.get_courses(include=["teachers", "term"]))
        list(canvas.get_courses(include=("term",)))

