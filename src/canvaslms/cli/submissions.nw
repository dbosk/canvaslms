def test_added_file_does_not_steal_an_edited_file(self):
    """Editing lab.py and adding lab_test.py is not a rename"""
    prev = {"attachments": {"lab.py": "old lab\n"}}
    curr = {"attachments": {"lab.py": "new lab\n",
                            "lab_test.py": "tests\n"}}

    diff = generate_diff(prev, curr, "Version 0", "Version 1")

    assert "--- Version 0/lab.py\n+++ Version 1/lab.py\n" in diff
    assert "--- Version 0/lab_test.py\n" \
           "+++ Version 1/lab_test.py\n" in diff
    assert "--- Version 0/lab.py\n+++ Version 1/lab_test.py\n" not in diff
    assert "-old lab\n" in diff
    assert "+new lab\n" in diff
