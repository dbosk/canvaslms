            ({"rubric_assessment": {"crit": {"points": 0}}}, False),
            ({"grade": "0"}, False),
        ],
    )
    def test_detects_null_submissions(self, attrs, expected):
        """A null submission has neither work nor feedback."""
        assert is_null_submission(make_submission(**attrs)) is expected


class TestFilterViewSubmissions:
    """Test the view-specific filtering of null submissions."""

    def test_skips_null_submissions_by_default(self):
        """View should hide placeholder rows unless opted in."""
        null_submission = make_submission()
        visible_submission = make_submission(
            submission_comments=[{"comment": "Missing"}]
        )

        assert filter_view_submissions([
            null_submission,
            visible_submission,
        ]) == [visible_submission]

    def test_keeps_null_submissions_when_requested(self):
        """The opt-in flag should preserve placeholder rows."""
        null_submission = make_submission()
        visible_submission = make_submission(
            submission_comments=[{"comment": "Missing"}]
        )

        assert filter_view_submissions(
            [null_submission, visible_submission],
            include_null_submissions=True,
        ) == [null_submission, visible_submission]

    def test_ignores_placeholder_history_entries(self):
        """History should matter only when a version contains real work."""
        null_submission = make_submission(submission_history=[{}])
        visible_submission = make_submission(
            submission_history=[{"body": "answer"}]
        )

        assert filter_view_submissions([
            null_submission,
            visible_submission,
        ]) == [visible_submission]
