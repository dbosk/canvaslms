Let's verify that both an addition and a removal leave the module in the
\enquote{never fetched} state.
We give the mock module a real dictionary and timestamp, because those are
what the caching decorator stores and what [[invalidate_module_items]] must
reset.
<<test functions>>=
def make_cached_module(name, module_id, items):
  """Create a module mock carrying cache state and the given items."""
  module = MagicMock()
  module.name = name
  module.id = module_id
  module.get_module_items.return_value = items
  module.module_item_cache = {item.id: (item, {}) for item in items}
  module.module_item_all_fetched = datetime.now()
  return module

def make_assignment_item(content_id, position=None):
  """Create an Assignment module item mock."""
  item = make_module_item(position, item_type="Assignment")
  item.content_id = content_id
  item.id = 100 + content_id
  return item

def test_adding_item_invalidates_module_cache():
  module = make_cached_module("Week 1", 11, [])
  course = MagicMock()
  course.get_modules.return_value = [module]
  update_item_modules(course, 'Assignment', 42, ["^Week 1$"])
  module.create_module_item.assert_called_once()
  assert module.module_item_cache == {}
  assert module.module_item_all_fetched is None

def test_removing_item_invalidates_module_cache():
  item = make_assignment_item(42)
  module = make_cached_module("Week 1", 11, [item])
  course = MagicMock()
  course.get_modules.return_value = [module]
  update_item_modules(course, 'Assignment', 42, [])
  item.delete.assert_called_once()
  assert module.module_item_cache == {}
  assert module.module_item_all_fetched is None
