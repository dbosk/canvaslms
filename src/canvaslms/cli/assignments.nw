        course.get_assignments = Mock(return_value=[first, second])

        first.get_submissions = Mock(return_value=[])
        second.get_submissions = Mock(return_value=[])

        list(list_ungraded_assignments([course]))

        course.get_assignments.assert_called_once_with()

    def test_filters_assignments_by_submission_state(self):
        """Assignments should stay when any submission still needs grading."""
        course = self.make_course()
        graded_assignment = self.make_assignment(1, "Lab 1")
        ungraded_assignment = self.make_assignment(2, "Lab 2")
        course.get_assignments = Mock(
            return_value=[graded_assignment, ungraded_assignment]
        )

        graded_submission = Mock(spec=[
            "submitted_at",
            "graded_at",
