class TestAssignmentGroupSpec:
  def test_name_regex_resolves_to_the_group_id(self):
    course = course_with_groups((31, "Labs"), (32, "Participation INL1"))
    assert resolve_assignment_group(course, "^Participation") == 32

  def test_numeric_id_resolves(self):
