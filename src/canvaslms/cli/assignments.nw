        ])
        graded_submission.submitted_at = "2024-01-01T10:00:00Z"
        graded_submission.graded_at = "2024-01-01T12:00:00Z"
        graded_submission.grade_matches_current_submission = True

        resubmitted = Mock(spec=[
            "submitted_at",
            "graded_at",
