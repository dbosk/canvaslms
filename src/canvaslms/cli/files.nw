def add_command(subp):
  """Adds the files command with subcommands to argparse parser"""
  files_parser = subp.add_parser("files",
    help="Manage course files",
    description="Manage files in Canvas courses: list, upload and edit "
                "(lock or hide) them.")
  files_subp = files_parser.add_subparsers(
    title="files commands",
    dest="files_command",
    required=True)

  <<add files list subcommand>>
  <<add files upload subcommand>>
  <<add files edit subcommand>>
