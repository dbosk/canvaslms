def serve_listing(rsps, files=FILES, folders=FOLDERS):
  """Answer the course's folder and file listings."""
  rsps.get(f"{API}/courses/1/folders", json=folders)
  rsps.get(f"{API}/courses/1/files", json=files)

def run(command, course, **options):
