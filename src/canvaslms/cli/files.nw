  help="Upload files to a course folder",
  description="Uploads files into a folder of courses, creating the folder "
              "if needed. A file with the same name in the folder is "
              "replaced: Canvas gives the new version a new ID but points "
              "module items and page links to it, and it keeps the old "
              "file's locked and hidden flags. Prints the uploaded files "
              "in the format of files list, including the link to use in "
              "a page's Markdown.")
upload_parser.set_defaults(func=files_upload_command)
canvaslms.cli.courses.add_course_option(upload_parser, required=True)
upload_parser.add_argument("--folder", required=True, metavar="PATH",
