\section{The [[files list]] subcommand}

[[files list]] prints one row per file, tab-separated like the other list
commands, and a selection that matches nothing is an empty-list error.
<<add files list subcommand>>=
list_parser = files_subp.add_parser("list",
  help="List files in a course",
  description="Lists the files of courses. Output: <course> <path> <id> "
              "<locked|unlocked> <hidden|visible> <link>, where <link> is "
              "the course-independent link to use in a page's Markdown.")
list_parser.set_defaults(func=files_list_command)
add_file_options(list_parser)
@

The selection options are shared with [[files edit]].
<<functions>>=
def add_file_options(parser, required=False):
  """Add the course and file selection options to `parser`."""
  canvaslms.cli.courses.add_course_option(parser, required=required)
  parser.add_argument("-f", "--file", default=".*", required=required,
    help="Regex matching the file's path below the course files root "
         "(e.g. handouts/lab1.pdf) or its Canvas ID, default: '.*'")
  parser.add_argument("--folder", metavar="REGEX",
    help="Regex matching the path of the file's folder; the root folder's "
         "path is the empty string")

def process_file_option(canvas, args):
  """Return the files of the selected courses that match the options."""
  files = []
  for course in canvaslms.cli.courses.process_course_option(canvas, args):
    files.extend(filter_files(course, args.file, args.folder))
  if not files:
    raise canvaslms.cli.EmptyListError("No files found matching the criteria")
  return files

def files_list_command(config, canvas, args):
  """List the files of courses."""
  output = csv.writer(sys.stdout, delimiter=args.delimiter)
  for file in process_file_option(canvas, args):
    output.writerow(file_row(file))
@

