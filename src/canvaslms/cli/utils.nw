class TestFormatCanvasTimeAcrossDST:
    """The UTC offset must come from the target date, not from today"""

    def test_naive_datetime_uses_the_offset_of_its_own_date(self):
        """
        Stockholm is CEST (+02:00) in July and CET (+01:00) in December.

        A single offset sampled at 'now' cannot satisfy both assertions.
        """
        summer = format_canvas_time(dt_datetime(2023, 7, 15, 10, 0, 0))
        winter = format_canvas_time(dt_datetime(2023, 12, 15, 10, 0, 0))
        assert summer == "2023-07-15T08:00:00Z"
        assert winter == "2023-12-15T09:00:00Z"

    def test_date_uses_the_offset_of_its_own_date(self):
        """A July day begins at 22:00 UTC, a December day at 23:00"""
        from datetime import date
        summer = format_canvas_time(date(2023, 7, 15))
        winter = format_canvas_time(date(2023, 12, 15))
        assert summer == "2023-07-14T22:00:00Z"
        assert winter == "2023-12-14T23:00:00Z"

    def test_naive_string_uses_the_offset_of_its_own_date(self):
        """Naive strings follow the same rule as naive datetimes"""
        summer = format_canvas_time("2023-07-15T10:00:00")
        winter = format_canvas_time("2023-12-15T10:00:00")
        assert summer == "2023-07-15T08:00:00Z"
        assert winter == "2023-12-15T09:00:00Z"
