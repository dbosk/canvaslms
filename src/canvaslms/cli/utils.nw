class TestEnsureSubmissionAttrs:
    """ensure_submission_attrs routes lazy wrappers through their own hook."""

    def test_delegates_to_lazy_hook(self):
        """Objects exposing ensure_attrs are normalized through that hook."""
        class FakeLazy:
            def __init__(self):
