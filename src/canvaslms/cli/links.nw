\section{Links inside structured content}

Quiz questions do not arrive as one body but as a JSON tree in which
question stems, answers and comments are HTML strings, each of which may
contain links.
Rather than knowing every field name for every question type, we
translate every string in the tree: a string without a link attribute is
returned by [[rewrite_link_attributes]] as it was, so the walk is safe on
titles and identifiers, and it needs no update when Canvas adds a field.
<<functions>>=
def rewrite_links_in_tree(tree, rewrite):
  """Apply `rewrite(text) -> (text, problems)` to every string in `tree`.

  `tree` is nested dicts, lists and scalars as loaded from JSON or
  YAML. Returns `(new tree, problems)` with all problems collected.
  """
  problems = []

  def walk(node):
    if isinstance(node, str):
      new, found = rewrite(node)
      problems.extend(found)
      return new
    if isinstance(node, dict):
      return {key: walk(value) for key, value in node.items()}
    if isinstance(node, list):
      return [walk(value) for value in node]
    return node

  return walk(tree), problems
@

<<test functions>>=
def test_tree_walk_translates_strings_at_any_depth():
  course = fake_course()
  tree = {"title": "Q1", "points": 2,
          "item_body": '<p>See <a href="/courses/59543/pages/setup">s</a></p>',
          "choices": [{"id": "a", "item_body": '<img src="/courses/59543/files/789/preview">'},
                      {"id": "b", "item_body": "plain"}]}
  out, problems = rewrite_links_in_tree(
    tree, lambda text: symbolize_links(text, course, SERVER))
  assert out["title"] == "Q1" and out["points"] == 2
  assert '"$WIKI_REFERENCE$/pages/setup"' in out["item_body"]
  assert '"$IMS-CC-FILEBASE$/slides/intro%20a.pdf?canvas_preview=1"' in \
    out["choices"][0]["item_body"]
  assert out["choices"][1]["item_body"] == "plain"
  assert problems == []
