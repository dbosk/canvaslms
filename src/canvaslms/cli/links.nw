Let's verify the tables: names by id, candidates exactly and ignoring
case, ambiguity, the module item and page fallbacks, the file path both
ways, and that a page lookup fetches no assignment list.
<<test functions>>=
def test_index_names_objects_by_id():
  index = CourseIndex(fake_course())
  assert index.name("assignments", 123456) == "HAC Ch 6: Stream ciphers"
  assert index.name("quizzes", 34) == "INL1Quiz"
  assert index.name("discussion_topics", 57) == "Welcome"
  assert index.name("modules", 12) == "Week 1"
  assert index.name("assignments", 999) is None

def test_index_finds_candidates_exactly_then_ignoring_case():
  index = CourseIndex(fake_course())
  assert [a.id for a in index.candidates("assignments", "hac ch 6: STREAM ciphers")] == [123456]
  assert [a.id for a in index.candidates("assignments", "Lab 1")] == [7, 8]
  assert index.candidates("assignments", "Lab 2") == []
  assert index.is_ambiguous("assignments", "Lab 1")
  assert not index.is_ambiguous("assignments", "Lab 2")

def test_index_finds_module_items():
  index = CourseIndex(fake_course())
  module, item = index.module_items()[345]
  assert module.name == "Week 1" and item.title == "Lecture: Intro"
  found = index.module_item_candidates("Week 1", "Lecture: Intro")
  assert [i.id for i in found] == [345]
  assert index.module_item_candidates("Week 2", "Lecture: Intro") == []

def test_index_finds_pages_by_slug_then_by_title():
  index = CourseIndex(fake_course())
  assert index.page_candidates("setup")[0].title == "Setup"
  assert index.page_candidates("grading-criteria")[0].url == \
    "grading-criteria"
  assert index.page_candidates("missing") == []

def test_slugify_matches_canvas():
  assert slugify("Grading criteria") == "grading-criteria"
  assert slugify("Page on zoom+campus!") == "page-on-zoom+campus"

def test_index_names_files_by_path_both_ways():
  index = CourseIndex(fake_course())
  assert index.file_path(789) == ("slides", "intro a.pdf")
  assert index.file_path(1) is None
  assert [f.id for f in index.file_candidates("slides", "intro a.pdf")] == [789]
  assert [f.id for f in index.file_candidates("slides", "intro+a.pdf")] == [789]
  assert index.file_candidates("slides", "other.pdf") == []
  assert index.file_candidates("nowhere", "intro a.pdf") == []

def test_index_fetches_only_the_kinds_asked_for():
  course = fake_course()
  index = CourseIndex(course)
  index.page_candidates("setup")
  course.get_assignments.assert_not_called()
  course.get_modules.assert_not_called()
  index.name("assignments", 7)
  index.name("assignments", 8)
  course.get_assignments.assert_called_once()
@
