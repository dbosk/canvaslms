<<fake files and folders>>=
root = MagicMock()
root.id = 1
root.full_name = "course files"
root.get_files.return_value = []
folder = MagicMock()
folder.id = n["folder"]
folder.full_name = "course files/slides"
file = obj(id=n["file"], display_name="intro a.pdf",
           filename="intro+a.pdf", folder_id=n["folder"])
folder.get_files.return_value = [file]
def get_file(file_id):
  if file_id == n["file"]:
    return file
  raise LookupError(file_id)
course.get_file.side_effect = get_file
course.get_folder.side_effect = lambda folder_id: \
  {root.id: root, folder.id: folder}[folder_id]
def resolve_path(path=None):
  if not path:
    return [root]
  if path == "slides":
    return [root, folder]
  raise LookupError(path)
course.resolve_path.side_effect = resolve_path
