The page lookup raises for an unknown slug, as [[canvasapi]] does.
<<fake pages>>=
pages = {"grading-criteria": obj(url="grading-criteria",
                                 title="Grading criteria"),
         "setup": obj(url="setup", title="Setup")}
course.get_pages.return_value = list(pages.values())
def get_page(slug):
  if slug in pages:
    return pages[slug]
  raise LookupError(slug)
course.get_page.side_effect = get_page
