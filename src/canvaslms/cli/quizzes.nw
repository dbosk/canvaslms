def strip_canvaslms_settings(quiz_params):
  """Remove canvaslms-only keys from `quiz_params` in place.

  Returns the `modules` value (None when absent); `id` and `regex` are
  dropped.
  """
  module_specs = quiz_params.pop('modules', None)
  for key in CANVASLMS_SETTINGS_KEYS:
    quiz_params.pop(key, None)
  return module_specs
