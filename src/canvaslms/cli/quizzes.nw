Canvas does not support nesting groups, so a group entry inside a pool is an
error in the JSON; we count it as failed rather than sending it to Canvas as
if it were a question.

<<create the pool questions in the group>>=
success = 0
failed = 0

for i, question in enumerate(pool, 1):
  if 'group' in question:
    print(f"  Failed: nested question groups are not supported "
          f"(in group {name})", file=sys.stderr)
    failed += 1
    continue

  try:
    quiz.create_question(
      question={**question, 'quiz_group_id': group.id})
    print(f"  Added: {question.get('question_name', f'Question {i}')} "
          f"(in group {name})")
    success += 1
  except Exception as e:
    print(f"  Failed: {question.get('question_name', f'Question {i}')} - {e}",
          file=sys.stderr)
    failed += 1
