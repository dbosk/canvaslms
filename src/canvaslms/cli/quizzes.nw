if 'time_limit' in quiz_params:
  seconds = quiz_params['time_limit']
  <<warn when the two time limit statements disagree>>
  params.pop(SESSION_TIME_LIMIT_PARAM, None)
  params.update(new_quiz_time_limit_params(seconds))
@

