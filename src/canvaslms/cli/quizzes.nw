  with caplog.at_level(logging.WARNING):
    success, failed = quizzes.add_classic_question_group(
      quiz, {'name': 'empty', 'pick_count': 1}, [])
  assert (success, failed) == (0, 0)
  assert 'empty question pool' in caplog.text
