<<create the question group>>=
clean_spec = {key: group_spec[key]
              for key in ('name', 'pick_count', 'question_points')
              if key in group_spec}
name = clean_spec.get('name', 'unnamed group')

try:
  group = quiz.create_question_group([clean_spec])
except Exception as e:
