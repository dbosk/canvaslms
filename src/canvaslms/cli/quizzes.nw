    if span_resp_index == resp_index:
      count = candidate_counts[phrase]
      span_len = end - start + 1
      occurrences.append((phrase, start, end, count, span_len))

occurrences.sort(key=lambda item: (-item[3], -item[4], -len(item[0])))
