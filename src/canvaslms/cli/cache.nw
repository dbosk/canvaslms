def test_a_roster_with_someone_who_left_does_not_wait_for_retries(
    unreachable_canvas, caplog):
  """Everyone still listed has the email, only the one who left lacks it."""
  canvas, sleeps = unreachable_canvas
  course = canvas.course_cache[1][0]
  requester = canvas._Canvas__requester
  listed = canvasapi.user.User(requester, {"id": 7, "email": "x@example.org"})
  left = canvasapi.user.User(requester, {"id": 8})
  left._unlisted = True
  course.user_cache = {7: (listed, {"include": ["email"]}), 8: (left, {})}
  course.user_all_fetched = datetime.now() - timedelta(hours=1)

  with caplog.at_level(logging.WARNING):
    users = list(course.get_users(include=["email"]))

  assert sorted(user.id for user in users) == [7, 8]
  assert sleeps == []
  assert retries_in_place(canvas)
  assert "Could not refresh" in caplog.text

@responses.activate
def test_asking_about_a_course_no_longer_listed_gets_one_try():
  """The listing answers here, so we look at the retries of the single request."""
  canvas = cache.create_canvas(HOST, "token")
  session = canvas._Canvas__requester._session
  responses.get(COURSES_URL, json=[{"id": 1, "name": "One"},
                                   {"id": 2, "name": "Two"}])
  list(canvas.get_courses())
  responses.replace(responses.GET, COURSES_URL, json=[{"id": 1, "name": "One"}])
  retries = []

  def gone(request):
    retries.append(session.get_adapter(HOST).max_retries.total)
    return (404, {}, '{"errors": [{"message": "Not Found"}]}')

  responses.add_callback(responses.GET, f"{COURSES_URL}/2", callback=gone)
  canvas.course_all_fetched = None

  assert [course.id for course in canvas.get_courses()] == [1]
  assert retries == [0]
  assert session.get_adapter(HOST).max_retries.total == 10

