HOST = "https://canvas.example"
COURSES_URL = f"{HOST}/api/v1/courses"

@pytest.fixture
def restored_canvas(tmp_cache_path, monkeypatch):
  """Return a function that writes a cached course aged `age` and reloads it."""
  monkeypatch.setattr(
      canvaslms.cli.login, "load_credentials", lambda config: (HOST, "token"))

  def restore(age):
    canvas = cache.create_canvas(HOST, "token")
    responses.get(COURSES_URL, json=[{"id": 1, "name": "Old course"}])
    course = list(canvas.get_courses())[0]
    course.assignment_cache["sentinel"] = "subtree"
    canvas.course_all_fetched = datetime.now() - age
    cache.save_canvas_cache(canvas, "token", HOST)

    responses.reset()
    responses.get(COURSES_URL, json=[{"id": 1, "name": "Old course"},
                                     {"id": 2, "name": "New course"}])
    return cache.load_configured_canvas({})[0]

  return restore

@responses.activate
def test_expired_course_listing_is_fetched_again(restored_canvas):
  canvas = restored_canvas(timedelta(days=cache.COURSE_CACHE_TTL_DAYS + 1))

  courses = {course.id: course for course in canvas.get_courses()}

  assert set(courses) == {1, 2}
  assert courses[1].assignment_cache == {"sentinel": "subtree"}

@responses.activate
def test_recent_course_listing_is_not_fetched_again(restored_canvas):
  canvas = restored_canvas(timedelta(hours=1))

  courses = {course.id: course for course in canvas.get_courses()}

  assert set(courses) == {1}
  assert len(responses.calls) == 0
