The tests above stub the HTTP layer, which leaves out the retry policy, and that
is what decides how long the user waits.
So here we use the real client against a port where nothing listens, recording
the sleeps of the retries instead of sleeping them.
What varies is who needs the request: a precaution gets one try, and a request the
caller depends on still gets all of them.

<<test functions>>=
@pytest.fixture
def unreachable_canvas(monkeypatch):
  """Return a canvas with a cached course, and the list of retry sleeps."""
  with socket.socket() as unused:
    unused.bind(("127.0.0.1", 0))
    port = unused.getsockname()[1]

  sleeps = []
  monkeypatch.setattr(time, "sleep", sleeps.append)
  canvas = cache.create_canvas(f"http://127.0.0.1:{port}", "token")
  course = canvasapi.course.Course(canvas._Canvas__requester,
                                   {"id": 1, "name": "Old course"})
  canvas.course_cache[1] = (course, {})
  canvas.course_all_fetched = datetime.now() - timedelta(hours=1)
  return canvas, sleeps

def retries_in_place(canvas):
  session = canvas._Canvas__requester._session
  return session.get_adapter("http://canvas.example").max_retries.total == 10

def test_expired_course_listing_does_not_wait_for_retries(unreachable_canvas):
  canvas, sleeps = unreachable_canvas
  canvas.course_all_fetched -= timedelta(days=cache.COURSE_CACHE_TTL_DAYS + 1)

  assert [course.id for course in canvas.get_courses()] == [1]

  assert sleeps == []
  assert retries_in_place(canvas)

