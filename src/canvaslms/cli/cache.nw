def envelope(path):
  """Return the decrypted envelope of the cache file at `path`."""
  return pickle.loads(
      Fernet(cache.derive_key("token", HOST)).decrypt(path.read_bytes()))

def users_in_file(path):
  """Return how many users the courses in the cache file at `path` hold."""
  return sum(len(course.user_cache)
             for course, _ in envelope(path)["canvas"].course_cache.values())

