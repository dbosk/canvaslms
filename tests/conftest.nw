\subsection{Mock user and group objects}

Users are students, teachers, and TAs.
Groups are collections of students for group assignments.
The user is the one a teacher sees: Canvas sends [[login_id]] only to users
with permission to see it, and [[email]] only for [[include[]=email]]; the
fixture includes it, as for the commands that ask for e-mail addresses.
<<mock user and group fixtures>>=
from canvasapi.group import Group
from canvasapi.user import User


@pytest.fixture
def mock_user():
    """
    Canvas User object.

    Attributes:
        id: User ID
        name: Full name
        sortable_name: "Last, First" format
        login_id: Username
        email: Email address (may be None due to privacy settings)
    """
    return User(MagicMock(), {
        "id": 3001,
        "name": "Alice Anderson",
        "sortable_name": "Anderson, Alice",
        "login_id": "alice",
        "email": "alice@example.edu",
    })


@pytest.fixture
def mock_group():
    """
    Canvas Group object.

    Groups are collections of users for collaborative assignments.

    Attributes:
        id: Group ID
        name: Group name
        members_count: Number of members

    Methods:
        get_users(): Returns empty list (override in tests)
    """
    group = Group(MagicMock(), {
        "id": 4001,
        "name": "Project Team Alpha",
        "members_count": 3,
    })
    stub_canvas_method(group, "get_users", [])

    return group
